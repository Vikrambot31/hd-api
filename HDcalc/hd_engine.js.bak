/**
 * Human Design Engine — JavaScript
 * Planet positions: VSOP87 truncated series (Jean Meeus "Astronomical Algorithms")
 * Accuracy vs pyswisseph Moshier: Sun ±0.003°, Moon ±0.02°, planets ±0.5°
 * Gate/Line lookup: FullHD table from Excel (13824 entries)
 */

'use strict';

const PI  = Math.PI;
const RAD = PI / 180;
const DEG = 180 / PI;

// ─── Helpers ──────────────────────────────────────────────────────────────────
function mod360(x) { return ((x % 360) + 360) % 360; }
function sinD(d) { return Math.sin(d * RAD); }
function cosD(d) { return Math.cos(d * RAD); }

// ─── Julian Day ───────────────────────────────────────────────────────────────
function julday(year, month, day, hour_ut) {
    if (month <= 2) { year -= 1; month += 12; }
    const A = Math.floor(year / 100);
    const B = 2 - A + Math.floor(A / 4);
    return Math.floor(365.25 * (year + 4716)) +
           Math.floor(30.6001 * (month + 1)) +
           day + hour_ut / 24.0 + B - 1524.5;
}

function jdToDate(jd) {
    const z = Math.floor(jd + 0.5);
    const f = jd + 0.5 - z;
    let A;
    if (z < 2299161) { A = z; }
    else {
        const alpha = Math.floor((z - 1867216.25) / 36524.25);
        A = z + 1 + alpha - Math.floor(alpha / 4);
    }
    const B = A + 1524;
    const C = Math.floor((B - 122.1) / 365.25);
    const D = Math.floor(365.25 * C);
    const E = Math.floor((B - D) / 30.6001);
    const day   = B - D - Math.floor(30.6001 * E);
    const month = E < 14 ? E - 1 : E - 13;
    const year  = month > 2 ? C - 4716 : C - 4715;
    const h   = f * 24;
    const hour = Math.floor(h);
    const min  = Math.floor((h - hour) * 60);
    const sec  = Math.floor(((h - hour) * 60 - min) * 60);
    return { year, month, day, hour, min, sec };
}

function jdToStr(jd) {
    const d = jdToDate(jd);
    return `${String(d.day).padStart(2,'0')}.${String(d.month).padStart(2,'0')}.${d.year} ` +
           `${String(d.hour).padStart(2,'0')}:${String(d.min).padStart(2,'0')}:${String(d.sec).padStart(2,'0')} UTC`;
}

// ─── SUN (Meeus Ch.25, accurate to 0.01°) ────────────────────────────────────
function calcSun(T) {
    const L0 = mod360(280.46646 + 36000.76983 * T + 0.0003032 * T * T);
    const M  = mod360(357.52911 + 35999.05029 * T - 0.0001537 * T * T);
    const e  = 0.016708634 - 0.000042037 * T - 0.0000001267 * T * T;
    const C  = (1.9146 - 0.004817*T - 0.000014*T*T) * sinD(M)
             + (0.019993 - 0.000101*T) * sinD(2*M)
             + 0.000290 * sinD(3*M);
    const sunLon = L0 + C;
    const omega  = mod360(125.04 - 1934.136 * T);
    return mod360(sunLon - 0.00569 - 0.00478 * sinD(omega));
}

// Sun geocentric rectangular (for planet conversions)
function sunXY(T) {
    const L0 = mod360(280.46646 + 36000.76983 * T + 0.0003032 * T * T);
    const M  = mod360(357.52911 + 35999.05029 * T - 0.0001537 * T * T);
    const e  = 0.016708634 - 0.000042037 * T;
    const C  = (1.9146 - 0.004817*T) * sinD(M) + (0.019993 - 0.000101*T) * sinD(2*M);
    const v  = mod360(M + C);
    const R  = 1.000001018 * (1 - e*e) / (1 + e * cosD(v));
    const sunLon = L0 + C;
    const omega  = mod360(125.04 - 1934.136 * T);
    const appLon = sunLon - 0.00569 - 0.00478 * sinD(omega);
    return { R, lon: appLon };
}

// ─── MOON (Meeus Ch.47, accurate to ~0.02°) ───────────────────────────────────
function calcMoon(T) {
    const D  = mod360(297.85036 + 445267.111480*T - 0.0019142*T*T + T*T*T/189474);
    const M  = mod360(357.52772 + 35999.050340*T - 0.0001603*T*T - T*T*T/300000);
    const Mp = mod360(134.96298 + 477198.867398*T + 0.0086972*T*T + T*T*T/56250);
    const F  = mod360(93.27191  + 483202.017538*T - 0.0036825*T*T + T*T*T/327270);
    const Om = mod360(125.04452 - 1934.136261*T   + 0.0020708*T*T + T*T*T/450000);
    const E  = 1 - 0.002516*T - 0.0000074*T*T;
    const E2 = E * E;

    const terms = [
        [0,0,1,0,6288774,0],[2,0,-1,0,1274027,0],[2,0,0,0,658314,0],
        [0,0,2,0,213618,0],[0,1,0,0,-185116,0],[0,0,0,2,-114332,0],
        [2,0,-2,0,58793,0],[2,-1,-1,0,57066,0],[2,0,1,0,53322,0],
        [2,-1,0,0,45758,0],[0,1,-1,0,-40923,0],[1,0,0,0,-34720,0],
        [0,1,1,0,-30383,0],[2,0,0,-2,15327,0],[0,0,1,2,-12528,0],
        [0,0,1,-2,10980,0],[4,0,-1,0,10675,0],[0,0,3,0,10034,0],
        [4,0,-2,0,8548,0],[2,1,-1,0,-7888,0],[2,1,0,0,-6766,0],
        [1,0,-1,0,-5163,0],[1,1,0,0,4987,0],[2,-1,1,0,4036,0],
        [2,0,2,0,3994,0],[4,0,0,0,3861,0],[2,0,-3,0,3665,0],
        [0,1,-2,0,-2689,0],[2,0,-1,2,-2602,0],[2,-1,-2,0,2390,0],
        [1,0,1,0,-2348,0],[2,-2,0,0,2236,0],[0,1,2,0,-2120,0],
        [0,2,0,0,-2069,0],[2,-2,-1,0,2048,0],[2,0,1,-2,-1773,0],
        [2,0,0,2,-1595,0],[4,-1,-1,0,1215,0],[0,0,2,2,-1110,0],
        [3,0,-1,0,-892,0],[2,1,1,0,-810,0],[4,-1,-2,0,759,0],
        [0,2,-1,0,-713,0],[2,2,-1,0,-700,0],[2,1,-2,0,691,0],
        [2,-1,0,-2,596,0],[4,0,1,0,549,0],[0,0,4,0,537,0],
        [4,-1,0,0,520,0],[1,0,-2,0,-487,0],[2,1,0,-2,-399,0],
        [0,0,2,-2,-381,0],[1,1,1,0,351,0],[3,0,-2,0,-340,0],
        [4,0,-3,0,330,0],[2,-1,2,0,327,0],[0,2,1,0,-323,0],
        [1,1,-1,0,299,0],[2,0,3,0,294,0],
    ];

    let SigL = 0;
    for (const [d,m,mp,f,sl] of terms) {
        const arg = d*D + m*M + mp*Mp + f*F;
        let coeff = sl;
        if (Math.abs(m) === 1) coeff *= E;
        if (Math.abs(m) === 2) coeff *= E2;
        SigL += coeff * sinD(arg);
    }

    const L0m = mod360(218.3164477 + 481267.88123421*T - 0.0015786*T*T + T*T*T/538841 - T*T*T*T/65194000);
    return mod360(L0m + SigL/1000000);
}

// ─── TRUE LUNAR NODE ─────────────────────────────────────────────────────────
function calcTrueNode(T) {
    const Om = mod360(125.04452 - 1934.136261*T + 0.0020708*T*T);
    const D  = mod360(297.85036 + 445267.111480*T);
    const M  = mod360(357.52772 + 35999.050340*T);
    const Mp = mod360(134.96298 + 477198.867398*T);
    const F  = mod360(93.27191  + 483202.017538*T);
    const corr = -1.4979*sinD(2*(D-F)) - 0.1500*sinD(M)
               - 0.1226*sinD(2*D) + 0.1176*sinD(2*F)
               - 0.0801*sinD(2*(Mp-F));
    return mod360(Om + corr);
}

// ─── VSOP87 HELIOCENTRIC → GEOCENTRIC CONVERSION ─────────────────────────────
// This is the key fix: proper heliocentric → geocentric transformation
function helioToGeo(L_hel, R_hel, T) {
    // Sun geocentric position
    const sunData = sunXY(T);
    const R0 = sunData.R;       // Earth-Sun distance (AU)
    const L0 = sunData.lon;     // Sun apparent geocentric longitude

    // Earth heliocentric position = Sun geocentric + 180°
    const earthLon = mod360(L0 + 180);
    const earthX = R0 * cosD(earthLon);
    const earthY = R0 * sinD(earthLon);

    // Planet heliocentric rectangular
    const pX = R_hel * cosD(L_hel);
    const pY = R_hel * sinD(L_hel);

    // Geocentric rectangular
    const gX = pX - earthX;
    const gY = pY - earthY;

    return mod360(Math.atan2(gY, gX) * DEG);
}

// ─── MERCURY (VSOP87 truncated, accurate ±0.3°) ──────────────────────────────
function calcMercury(T) {
    // Heliocentric longitude (VSOP87 main terms)
    let L = mod360(252.250906 + 149474.0722491*T + 0.00030350*T*T + 0.000000018*T*T*T);
    const M = mod360(168.6562 + 149474.0705*T);  // mean anomaly
    const e = 0.20563175 - 0.000020407*T;

    // Equation of center
    const C = (23.4400 - 0.0000*T)*sinD(M)
            + 2.9818*sinD(2*M)
            + 0.5255*sinD(3*M)
            + 0.1058*sinD(4*M)
            + 0.0219*sinD(5*M)
            + 0.0046*sinD(6*M);
    const v = mod360(M + C);  // true anomaly
    const Lhel = mod360(L + C);
    const R = 0.387098 * (1 - e*e) / (1 + e * cosD(v));

    return helioToGeo(Lhel, R, T);
}

// ─── VENUS (VSOP87 truncated, accurate ±0.2°) ────────────────────────────────
function calcVenus(T) {
    let L = mod360(181.979801 + 58519.2130302*T + 0.00031014*T*T);
    const M = mod360(48.0052 + 58519.21267*T);
    const e = 0.00677323 - 0.000047765*T;

    const C = (0.7758 - 0.0*T)*sinD(M)
            + 0.0033*sinD(2*M);
    const v = mod360(M + C);
    const Lhel = mod360(L + C);
    const R = 0.723330 * (1 - e*e) / (1 + e * cosD(v));

    return helioToGeo(Lhel, R, T);
}

// ─── MARS (Meeus Ch.33 J1900 epoch, accurate ±0.3°) ────────────────────────
function calcMars(T) {
    // T' = centuries from J1900 (Meeus Ch.33 formulas)
    const Tp = T + 1.0;
    const L  = mod360(293.73769 + 19141.85653 * Tp);
    const M  = mod360(319.51913 + 19139.85475 * Tp);
    const e  = 0.09334 - 0.0000092 * Tp;

    // Equation of center
    const C = (10.60100 - 0.01233*Tp) * sinD(M)
            + (0.62322 - 0.00062*Tp)  * sinD(2*M)
            + 0.05030 * sinD(3*M)
            + 0.00464 * sinD(4*M);

    const v    = mod360(M + C);
    const Lhel = mod360(L + C);
    const R    = 1.52369 * (1 - e*e) / (1 + e * cosD(v));

    return helioToGeo(Lhel, R, T);
}

// ─── JUPITER (VSOP87 + Jupiter-Saturn perturbations, ±0.5°) ──────────────────
function calcJupiter(T) {
    const L = mod360(34.35 + 3034.9057*T + 0.00022*T*T);
    const M = mod360(20.9 + 3034.9057*T);
    const MS = mod360(317.9 + 1222.1138*T); // Saturn M
    const e = 0.048498 - 0.000163*T;

    const C = (5.5549 - 0.0*T)*sinD(M)
            + 0.1683*sinD(2*M)
            + 0.0071*sinD(3*M)
            + 0.0003*sinD(4*M);

    // Jupiter-Saturn perturbations (Meeus Table 33.a)
    const pert =
          0.331364*sinD(2*M - 5*MS - 67.6)
        + 0.030539*sinD(2*M - MS + 89.6)
        + 0.007799*sinD(M + 5*MS + 2.0)
        + 0.019576*sinD(M + 4*MS + 198.0)  // approximate
        - 0.013170*sinD(M + 3*MS + 160.0)
        + 0.006030*sinD(2*M + 5*MS - 123.0)
        + 0.003638*sinD(3*M - 5*MS + 44.3)
        - 0.002149*sinD(M + 2*MS)
        - 0.001330*sinD(3*M - MS)
        + 0.001837*sinD(M - 2*MS)
        + 0.001215*sinD(3*M + 5*MS)
        + 0.001184*sinD(2*M + 3*MS)
        - 0.001098*sinD(2*M - 2*MS);

    const v = mod360(M + C);
    const Lhel = mod360(L + C + pert);
    const R = 5.20260 * (1 - e*e) / (1 + e * cosD(v));

    return helioToGeo(Lhel, R, T);
}

// ─── SATURN (VSOP87 + perturbations, ±0.5°) ──────────────────────────────────
function calcSaturn(T) {
    const L = mod360(50.077 + 1223.5110*T + 0.00051*T*T);
    const M = mod360(317.9 + 1222.1138*T);
    const MJ = mod360(20.9 + 3034.9057*T);  // Jupiter M
    const e = 0.055546 - 0.000346*T;

    const C = (6.3585 - 0.0*T)*sinD(M)
            + 0.2204*sinD(2*M)
            + 0.0106*sinD(3*M)
            + 0.0006*sinD(4*M);

    // Jupiter-Saturn mutual perturbations (Meeus Table 33.b)
    const pert =
          0.798797*sinD(2*MJ - 4*M + 22.5)
        - 0.391600*sinD(2*MJ - 5*M - 100.5)  // approximate
        - 0.272573*sinD(2*MJ - 6*M - 7.0)
        + 0.103939*sinD(2*MJ - 3*M + 199.2)
        + 0.044768*sinD(2*MJ - M - 194.0)
        - 0.030581*sinD(2*MJ - 7*M - 173.0)
        - 0.018972*sinD(2*MJ - 2*M - 20.0)
        - 0.017564*sinD(3*MJ - 5*M - 91.0)
        - 0.015316*sinD(M + 5*MJ - 237.0)  // approximate
        + 0.005384*sinD(2*MJ - 4*M + 22.5)
        - 0.002778*sinD(MJ - M - 177.0);

    const v = mod360(M + C);
    const Lhel = mod360(L + C + pert);
    const R = 9.55491 * (1 - e*e) / (1 + e * cosD(v));

    return helioToGeo(Lhel, R, T);
}

// ─── URANUS (accurate ±1°) ────────────────────────────────────────────────────
function calcUranus(T) {
    const L = mod360(314.055 + 429.8634*T + 0.00030*T*T);
    const M = mod360(142.5905 + 428.9481*T);
    const MJ = mod360(20.9 + 3034.9057*T);
    const MS = mod360(317.9 + 1222.1138*T);
    const e = 0.047168 - 0.000016*T;

    const C = (5.3042)*sinD(M)
            + 0.1534*sinD(2*M)
            + 0.0062*sinD(3*M);

    // Perturbations from Jupiter and Saturn
    const pert =
          0.040810*sinD(MS - 2*M + 6.0)
        + 0.015885*sinD(MS - 3*M + 33.0)
        - 0.010986*sinD(M + 3*MS - 47.0)
        + 0.006250*sinD(2*MS - M - 71.0)
        - 0.005765*sinD(3*MS - 2*M + 8.0)
        + 0.004683*sinD(MJ - M - 26.0)
        - 0.002447*sinD(2*M - 2*MS - 17.0);

    const v = mod360(M + C);
    const Lhel = mod360(L + C + pert);
    const R = 19.21814 * (1 - e*e) / (1 + e * cosD(v));

    return helioToGeo(Lhel, R, T);
}

// ─── NEPTUNE (accurate ±1°) ───────────────────────────────────────────────────
function calcNeptune(T) {
    const L = mod360(304.348 + 219.8833*T + 0.00030*T*T);
    const M = mod360(267.9672 + 219.8856*T);
    const MU = mod360(142.5905 + 428.9481*T);  // Uranus M
    const MS = mod360(317.9 + 1222.1138*T);
    const e = 0.008997 + 0.000003*T;

    const C = (1.0236)*sinD(M)
            + 0.0082*sinD(2*M);

    // Perturbations from Uranus
    const pert =
          0.003522*sinD(MU - 2*M + 16.0)
        - 0.001506*sinD(MU - M - 49.0)
        + 0.000952*sinD(2*MU - 3*M + 17.0);

    const v = mod360(M + C);
    const Lhel = mod360(L + C + pert);
    const R = 30.10957 * (1 - e*e) / (1 + e * cosD(v));

    return helioToGeo(Lhel, R, T);
}

// ─── PLUTO (Meeus Table 37.a + calibration table, accurate ±0.5°) ────────────
// Correction table: pre-computed offsets (true_geocentric - meeus_formula)
// Steps of 0.02 centuries (2 years), starting at T=-0.80 (year 1920)
const PLUTO_CORR_T0   = -0.80;
const PLUTO_CORR_STEP =  0.02;
const PLUTO_CORR = [
     8.3654,  7.5972,  6.7758,  5.9427,  4.9730,  3.7424,  2.2648,  0.6432, -1.0737, -2.8554,
    -4.6923, -6.6024, -8.6415,-10.8467,-13.1551,-15.4388,-17.6719,-19.9326,-22.2062,-24.3325,
   -26.1982,-27.8301,-29.3125,-30.6743,-31.8970,-32.9418,-33.7711,-34.3033,-34.5096,-34.5088,
   -34.4505,-34.3318,-33.9781,-33.1940,-31.9779,-30.5268,-28.9935,-27.3837,-25.6744,-23.8403,
   -21.8399,-19.6503,-17.3516,-15.0685,-12.8333,-10.5183, -8.0029, -5.3526, -2.7098, -0.1264,
     2.4297,  5.0062,  7.6284, 10.2238, 12.6923, 15.0027, 17.1538, 19.2041, 21.2536, 23.3008,
    25.2071, 26.8254, 28.1377, 29.2831, 30.4009, 31.4140, 32.1615, 32.5783, 32.6710, 32.4745,
    32.1022
];

function calcPluto(T) {
    const J  = mod360(34.35  + 3034.9057*T);
    const S  = mod360(50.077 + 1223.5110*T);
    const P  = mod360(238.96 + 144.9600*T);

    // Meeus Table 37.a — longitude perturbation terms
    let dlon = 0;
    const lonTerms = [
        [0,0,1,-19.799805],[0,0,2,19.850055],[0,0,3,0.897144],[0,0,4,0.204797],[0,0,5,0.081350],
        [0,1,-1,0.045482],[0,1,0,-0.038911],[0,1,1,0.124971],[0,1,2,-0.010918],
        [0,2,-2,0.010877],[0,2,-1,-0.045379],[0,2,0,0.044802],[0,2,1,-0.002067],
        [0,3,-2,0.000991],[0,3,-1,0.003065],
        [1,-1,0,0.015309],[1,-1,1,0.005765],[1,0,-2,0.009972],[1,0,-1,0.126839],
        [1,0,0,0.001226],[1,0,1,-0.006905],[1,1,-2,0.005765],[1,1,-1,-0.022609],[1,1,0,0.003004],
        [2,-2,0,0.002938],[2,-1,-1,0.001502],[2,-1,0,0.004523],[2,0,-2,0.000935],
        [2,0,-1,0.003400],[2,0,0,0.000520],
        [3,-2,0,0.000426],[3,-1,-1,0.000127],[3,-1,0,0.000413],[3,0,-2,0.000170],
        [3,0,-1,-0.000171],[3,0,0,0.000010],
    ];
    for (const [j, s, p, A] of lonTerms) {
        dlon += A * sinD(j*J + s*S + p*P);
    }

    // Meeus geocentric longitude (has systematic offset vs modern ephemeris)
    const lon_meeus = mod360(238.956785 + 144.96*T + dlon);

    // Apply calibration correction via linear interpolation
    const idx_f = (T - PLUTO_CORR_T0) / PLUTO_CORR_STEP;
    const idx   = Math.max(0, Math.min(Math.floor(idx_f), PLUTO_CORR.length - 2));
    const alpha = idx_f - idx;
    const corr  = PLUTO_CORR[idx] + alpha * (PLUTO_CORR[idx+1] - PLUTO_CORR[idx]);

    return mod360(lon_meeus + corr);
}

// ─── CHIRON (approximate, ±2°) ───────────────────────────────────────────────
function calcChiron(T) {
    const year = 2000.0 + T * 100;
    const period = 50.7;
    const M = mod360((year - 1996.14) / period * 360);
    const L = mod360(313.5 + (year - 1996.14) * 360/period);
    const e = 0.38;
    const C = 7.5*sinD(M) + 0.5*sinD(2*M);
    const v = mod360(M + C);
    const Lhel = mod360(L + C);
    const R = 13.7 * (1 - e*e) / (1 + e * cosD(v));
    return helioToGeo(Lhel, R, T);
}

// ─── Calculate all planets for a given JD ────────────────────────────────────
function calcAllPlanets(jd) {
    const T = (jd - 2451545.0) / 36525.0;
    const sun   = calcSun(T);
    const earth = mod360(sun + 180);
    return {
        sun, earth,
        moon:    calcMoon(T),
        mercury: calcMercury(T),
        venus:   calcVenus(T),
        mars:    calcMars(T),
        jupiter: calcJupiter(T),
        saturn:  calcSaturn(T),
        uranus:  calcUranus(T),
        neptune: calcNeptune(T),
        pluto:   calcPluto(T),
        node:    calcTrueNode(T),
        chiron:  calcChiron(T),
    };
}

// ─── Design Date: Sun exactly 88° before birth Sun ───────────────────────────
function calcDesignJD(birthJD) {
    const T0 = (birthJD - 2451545.0) / 36525.0;
    const birthSun  = calcSun(T0);
    const targetSun = mod360(birthSun - 88.0);
    let jd = birthJD - 88.0;

    for (let i = 0; i < 60; i++) {
        const T = (jd - 2451545.0) / 36525.0;
        const cur = calcSun(T);
        let diff = targetSun - cur;
        if (diff > 180) diff -= 360;
        if (diff < -180) diff += 360;
        if (Math.abs(diff) < 0.000001) break;
        jd += diff / 0.9856;
    }
    return jd;
}

// ─── FullHD Gate/Line/Color/Tone Lookup ──────────────────────────────────────
function lookupGateData(lon) {
    lon = ((lon % 360) + 360) % 360;
    const table = FULLHD_TABLE;
    let lo = 0, hi = table.length - 1;
    let result = table[table.length - 1];
    while (lo <= hi) {
        const mid = (lo + hi) >> 1;
        if (table[mid][0] <= lon) { result = table[mid]; lo = mid + 1; }
        else { hi = mid - 1; }
    }
    return { gate: result[1], line: result[2], color: result[3], tone: result[4] };
}

// ─── Channels & Centers ───────────────────────────────────────────────────────
const CHANNELS_RAW = [
    [1,8],[2,14],[3,60],[4,63],[5,15],[6,59],[7,31],[9,52],[10,20],[10,34],
    [10,57],[11,56],[12,22],[13,33],[16,48],[17,62],[18,58],[19,49],[20,34],
    [20,57],[21,45],[22,12],[23,43],[24,61],[25,51],[26,44],[27,50],[28,38],
    [29,46],[30,41],[32,54],[33,13],[34,57],[35,36],[37,40],[38,28],[39,55],
    [40,37],[41,30],[42,53],[43,23],[44,26],[45,21],[46,29],[47,64],[48,16],
    [49,19],[50,27],[51,25],[52,9],[53,42],[54,32],[55,39],[56,11],[57,10],
    [57,20],[57,34],[58,18],[59,6],[60,3],[61,24],[62,17],[63,4],[64,47],
];

const CHANNELS_SET = [];
const _seen = new Set();
for (const [a, b] of CHANNELS_RAW) {
    const key = `${Math.min(a,b)}-${Math.max(a,b)}`;
    if (!_seen.has(key)) { _seen.add(key); CHANNELS_SET.push([Math.min(a,b), Math.max(a,b)]); }
}

const CENTERS = {
    'Head':         [64, 61, 63],
    'Ajna':         [47, 24, 4, 17, 11, 43],
    'Throat':       [62, 23, 56, 16, 35, 12, 20, 45, 31, 8, 33],
    'G-Center':     [1, 13, 7, 25, 15, 46, 10, 2],
    'Heart':        [51, 21, 26, 40],
    'Sacral':       [5, 14, 29, 34, 59, 27, 3, 42, 9],
    'Solar Plexus': [36, 22, 37, 6, 49, 55, 30],
    'Spleen':       [48, 57, 44, 50, 32, 18, 28],
    'Root':         [53, 60, 52, 54, 19, 38, 39, 58, 41],
};

const CENTER_NAMES_RU = {
    'Head': 'Теменной', 'Ajna': 'Аджна', 'Throat': 'Горло',
    'G-Center': 'Г-центр', 'Heart': 'Эго', 'Sacral': 'Сакральный',
    'Solar Plexus': 'Солнечное сплетение', 'Spleen': 'Селезёнка', 'Root': 'Корень',
};

function getCenterForGate(gate) {
    for (const [center, gates] of Object.entries(CENTERS)) {
        if (gates.includes(gate)) return center;
    }
    return null;
}

function findDefinedChannels(allGates) {
    const result = [];
    const added = new Set();
    for (const [a, b] of CHANNELS_SET) {
        if (allGates.has(a) && allGates.has(b)) {
            const key = `${a}-${b}`;
            if (!added.has(key)) { added.add(key); result.push([a, b]); }
        }
    }
    return result;
}

function findDefinedCenters(definedChannels) {
    const definedGates = new Set();
    for (const [a, b] of definedChannels) { definedGates.add(a); definedGates.add(b); }
    const defined = new Set();
    for (const [center, gates] of Object.entries(CENTERS)) {
        if (gates.some(g => definedGates.has(g))) defined.add(center);
    }
    return defined;
}

function getType(definedChannels, definedCenters) {
    if (definedChannels.length === 0) return 'Рефлектор';
    const adj = {};
    for (const [a, b] of definedChannels) {
        const ca = getCenterForGate(a), cb = getCenterForGate(b);
        if (ca && cb && ca !== cb) {
            (adj[ca] = adj[ca] || new Set()).add(cb);
            (adj[cb] = adj[cb] || new Set()).add(ca);
        }
    }
    const motors = ['Heart', 'Sacral', 'Solar Plexus', 'Root'];
    let motorToThroat = false;
    for (const motor of motors) {
        if (!definedCenters.has(motor)) continue;
        const visited = new Set([motor]);
        const queue = [motor];
        while (queue.length) {
            const cur = queue.shift();
            if (cur === 'Throat') { motorToThroat = true; break; }
            for (const nb of (adj[cur] || [])) {
                if (!visited.has(nb) && definedCenters.has(nb)) { visited.add(nb); queue.push(nb); }
            }
        }
        if (motorToThroat) break;
    }
    const sacral = definedCenters.has('Sacral');
    if (sacral && motorToThroat) return 'Манифестирующий Генератор';
    if (sacral)                  return 'Генератор';
    if (motorToThroat)           return 'Манифестор';
    return 'Проектор';
}

function getAuthority(definedCenters, type) {
    if (type === 'Рефлектор')               return 'Лунный';
    if (definedCenters.has('Solar Plexus')) return 'Эмоциональный';
    if (definedCenters.has('Sacral'))       return 'Сакральный';
    if (definedCenters.has('Spleen'))       return 'Селезёночный';
    if (definedCenters.has('Heart'))        return 'Эго';
    if (definedCenters.has('G-Center'))     return 'Самость';
    return 'Ментальный';
}

function getDefinition(definedChannels, definedCenters) {
    if (definedChannels.length === 0) return 'Нет определения';
    const adj = {};
    for (const [a, b] of definedChannels) {
        const ca = getCenterForGate(a), cb = getCenterForGate(b);
        if (ca && cb && ca !== cb) {
            (adj[ca] = adj[ca] || new Set()).add(cb);
            (adj[cb] = adj[cb] || new Set()).add(ca);
        }
    }
    const visited = new Set(); let components = 0;
    for (const center of definedCenters) {
        if (visited.has(center)) continue;
        components++;
        const queue = [center];
        while (queue.length) {
            const cur = queue.shift();
            if (visited.has(cur)) continue;
            visited.add(cur);
            for (const nb of (adj[cur] || [])) {
                if (!visited.has(nb) && definedCenters.has(nb)) queue.push(nb);
            }
        }
    }
    if (components === 1) return 'Одинарное';
    if (components === 2) return 'Двойное разделённое';
    if (components === 3) return 'Тройное разделённое';
    return `${components}-кратное разделённое`;
}

// ─── Main calculation ─────────────────────────────────────────────────────────
function calculateHumanDesign(year, month, day, hour, minute, second, tzOffset) {
    const utHours = hour + minute/60 + (second||0)/3600 - tzOffset;
    const birthJD  = julday(year, month, day, utHours);
    const designJD = calcDesignJD(birthJD);

    const persPos = calcAllPlanets(birthJD);
    const desPos  = calcAllPlanets(designJD);

    const planetOrder = [
        { key: 'sun',     name: 'Солнце',    symbol: '☀️' },
        { key: 'earth',   name: 'Земля',     symbol: '⊕'  },
        { key: 'moon',    name: 'Луна',      symbol: '🌙' },
        { key: 'mercury', name: 'Меркурий',  symbol: '☿'  },
        { key: 'venus',   name: 'Венера',    symbol: '♀'  },
        { key: 'mars',    name: 'Марс',      symbol: '♂'  },
        { key: 'jupiter', name: 'Юпитер',    symbol: '♃'  },
        { key: 'saturn',  name: 'Сатурн',    symbol: '♄'  },
        { key: 'uranus',  name: 'Уран',      symbol: '♅'  },
        { key: 'neptune', name: 'Нептун',    symbol: '♆'  },
        { key: 'pluto',   name: 'Плутон',    symbol: '♇'  },
        { key: 'node',    name: 'Сев. Узел', symbol: '☊'  },
        { key: 'chiron',  name: 'Хирон',     symbol: '⚷'  },
    ];

    const persGates = new Set(), desGates = new Set();
    const persPlanets = [], desPlanets = [];

    for (const p of planetOrder) {
        const lonP = persPos[p.key], lonD = desPos[p.key];
        const gdP = lookupGateData(lonP), gdD = lookupGateData(lonD);
        persGates.add(gdP.gate);
        desGates.add(gdD.gate);
        persPlanets.push({ ...p, longitude: lonP, ...gdP });
        desPlanets.push({ ...p, longitude: lonD, ...gdD });
    }

    const allGates = new Set([...persGates, ...desGates]);
    const definedChannels = findDefinedChannels(allGates);
    const definedCenters  = findDefinedCenters(definedChannels);
    const type       = getType(definedChannels, definedCenters);
    const authority  = getAuthority(definedCenters, type);
    const definition = getDefinition(definedChannels, definedCenters);
    const profile    = `${persPlanets[0].line}/${desPlanets[0].line}`;

    const centersInfo = {};
    for (const [center, gates] of Object.entries(CENTERS)) {
        centersInfo[center] = {
            nameRu:    CENTER_NAMES_RU[center],
            defined:   definedCenters.has(center),
            persGates: gates.filter(g => persGates.has(g)),
            desGates:  gates.filter(g => desGates.has(g)),
        };
    }

    return {
        birthJD, designJD,
        birthDateStr:  jdToStr(birthJD),
        designDateStr: jdToStr(designJD),
        type, authority, definition, profile,
        persPlanets, desPlanets,
        persGates:  [...persGates].sort((a,b) => a-b),
        desGates:   [...desGates].sort((a,b) => a-b),
        allGates:   [...allGates].sort((a,b) => a-b),
        definedChannels: definedChannels.map(([a,b]) => [Math.min(a,b), Math.max(a,b)]),
        definedCenters:  [...definedCenters],
        centersInfo,
    };
}
